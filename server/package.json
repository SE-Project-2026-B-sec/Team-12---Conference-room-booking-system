    "@types/express-session": "^1.19.0",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "eslint": "^10.13.0",
    "prisma": "^6.19.0",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
