# Copy to .env and adjust. Never commit .env.
NODE_ENV=development
PORT=3000

# PostgreSQL (synthetic dev values only)
POSTGRES_USER=crbs
POSTGRES_PASSWORD=change_me
POSTGRES_DB=crbs
DATABASE_URL=postgresql://crbs:change_me@localhost:5432/crbs

# Session cookie signing secret (use a long random value)
SESSION_SECRET=change_me_to_a_long_random_string

# Organisation timezone (timestamps are stored in UTC)
ORG_TIMEZONE=Asia/Kolkata
