# Copy to .env and adjust. Never commit .env.
NODE_ENV=development
PORT=3000

# PostgreSQL (synthetic dev values only)
POSTGRES_USER=crbs
POSTGRES_PASSWORD=change_me
POSTGRES_DB=crbs
DATABASE_URL=postgresql://crbs:change_me@localhost:5432/crbs
# Integration tests only. The database name MUST end with _test; tests refuse to run otherwise.
DATABASE_URL_TEST=postgresql://crbs:change_me@localhost:5432/crbs_test

# Session cookie signing secret (use a long random value; required in production)
SESSION_SECRET=change_me_to_a_long_random_string

# Reverse proxy trust (set only when deployed behind a trusted proxy, e.g. 1 for NGINX/Caddy)
# TRUST_PROXY=1

# Organisation timezone (timestamps are stored in UTC)
ORG_TIMEZONE=Asia/Kolkata
